# ---------------------------------------------------------------------------
# Required — fill these in before running
# ---------------------------------------------------------------------------

# GitHub Personal Access Token (needs repo: Contents write permission)
# Create at: https://github.com/settings/tokens → Fine-grained tokens
# Permissions needed: Repository contents (Read and Write)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub username (repo owner)
GITHUB_OWNER=giftpasay

# Repository name (usually <username>.github.io)
GITHUB_REPO=giftpasay.github.io

# Google Gemini API key — used to format posts with Gemini
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token — get from @BotFather on Telegram
# Create a new bot: /newbot → copy the token here
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Comma-separated Telegram user IDs allowed to publish.
# Leave empty to allow any user (only safe for private bots).
# Find your ID by messaging @userinfobot on Telegram.
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Base URL of your site (no trailing slash)
SITE_BASE_URL=https://blog.giftpasay.com
